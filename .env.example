# Public URL of the site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://kortex.digital

# Contact form — https://resend.com
# Without these, the form logs submissions to the console in development
# and returns an error in production.
RESEND_API_KEY=
# Where new requests are delivered
CONTACT_TO_EMAIL=contact@kortex.digital
# Sender — must use a domain verified in Resend
CONTACT_FROM_EMAIL="KORTEX Digital <noreply@kortex.digital>"
