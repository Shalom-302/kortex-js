# Public URL of the site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://kortexdigital.net

# Contact form — https://resend.com
# Only RESEND_API_KEY is required. Without it, the form logs submissions to the
# console in development and returns an error in production.
RESEND_API_KEY=
# Where new requests are delivered (default: the founder's Gmail with the test sender,
# contact@kortexdigital.net once CONTACT_FROM_EMAIL is set).
# With the default test sender below, this MUST be the email of the Resend account.
CONTACT_TO_EMAIL=
# Sender (default: Resend's test sender onboarding@resend.dev, no domain needed, but
# it cannot send the confirmation email to visitors). Once kortexdigital.net is verified
# in Resend, set e.g.: CONTACT_FROM_EMAIL="KORTEX Digital <contact@kortexdigital.net>"
CONTACT_FROM_EMAIL=
